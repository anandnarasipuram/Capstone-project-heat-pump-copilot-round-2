# Copy to .env and fill in real values. Never commit .env.
# cp .env.example .env

# Cohere — powers classification (core/llm.py), the LLM judge
# (core/judge.py) and embeddings (core/rag.py).
COHERE_API_KEY=
COHERE_CHAT_MODEL=command-a-03-2025
COHERE_EMBEDDING_MODEL=embed-multilingual-v3.0

# Pinecone — vector store for the manual knowledge base (core/rag.py).
# Get a free-tier API key at https://app.pinecone.io.
# Run `python scripts/ingest_manuals.py` once after setting these to
# create the index and embed data/manuals/*.json into it.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=heat-pump-copilot-manuals-cohere
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# LangSmith — traces every AI call (retrieval + all 3 LLM call sites, see
# core/tracing.py + core/pipeline.py) so every interaction is inspectable:
# exact prompt, raw model output, latency, token usage. Get a key at
# https://smith.langchain.com. Optional — with no key, tracing is simply
# off and nothing else changes.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=heat-pump-copilot-round2
# Only needed if your LangSmith workspace is on the EU region (check the
# quickstart panel on smith.langchain.com) — Round 1's workspace was EU
# and every call 403'd until this was set explicitly, so check this first
# if traces aren't showing up. Otherwise omit this line.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Optional — if unset, the app runs in degraded/offline mode automatically:
# fault-code lookup (Mode 1) and the checklist/predictive math (Modes 2-3)
# all still work with zero keys; only the AI-generated text falls back to
# a clearly-labeled deterministic template. See mvp_documentation.md.
